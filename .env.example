# Copy to .env. Empty HA settings select labelled demonstration data.
HOST=127.0.0.1
PORT=4317
HA_URL=
HA_TOKEN=
# Choose a random pairing code of at least 8 characters for a live server.
TV_CLIENT_TOKEN=
# Choose a different long random secret for authorized webhook calls.
TV_WEBHOOK_TOKEN=
TV_SESSION_STORE=./private/state/sessions.json
TV_SESSION_DAYS=30
NIGHT_CONTROL_ENABLED=0
TV_CONTROL_ENABLED=0
TV_PUBLIC_ORIGIN=http://localhost:4317
CONFIG_PATH=./config.json
# Optional user-selected photo directory; never commit personal photos.
# PHOTO_DIR=/path/to/your/album
